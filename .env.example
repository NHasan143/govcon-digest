# Copy to .env and adjust per environment.
# NEXT_PUBLIC_* values are inlined at BUILD time — rebuild after changing them.
#
# Local development:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
#   NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Site identity
NEXT_PUBLIC_SITE_URL=https://govcondigest.com
NEXT_PUBLIC_SITE_NAME=Govcon Digest
NEXT_PUBLIC_SITE_TAGLINE=Your trusted news source
NEXT_PUBLIC_SITE_DESCRIPTION=Govcon Digest is a news publication.

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) — contact form.
# Get keys at https://www.google.com/recaptcha/admin — leave empty to disable.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_TWITTER_HANDLE=@govcondigest

# Internal API base (the app fetches its own /api routes)
NEXT_PUBLIC_API_URL=https://govcondigest.com/api

# Postal address (footer + organization JSON-LD)
NEXT_PUBLIC_ADDRESS_STREET=123 Example Street, Suite 100
NEXT_PUBLIC_ADDRESS_LOCALITY=City
NEXT_PUBLIC_ADDRESS_REGION=ST
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=00000
NEXT_PUBLIC_ADDRESS_COUNTRY=US

# Contact emails
NEXT_PUBLIC_CONTACT_EMAIL=contact@govcondigest.com
NEXT_PUBLIC_ADS_EMAIL=ads@govcondigest.com
NEXT_PUBLIC_SALES_EMAIL=sales@govcondigest.com
NEXT_PUBLIC_EVENTS_EMAIL=events@govcondigest.com

# Payload CMS
# Generate a unique secret per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-32-plus-char-random-hex

# Database (placeholder) — configure for the Govcon Digest project.
# The default adapter is SQLite (@payloadcms/db-sqlite). Set a connection
# string here; a local file works for development:
#   DATABASE_URI=file:./data/payload.db
# To use Postgres/MySQL instead, swap the adapter in payload.config.ts and
# point this at that database's URL.
DATABASE_URI=

# First CMS admin — created automatically on boot when no users exist yet.
# Changing these later does NOT update the existing user.
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=replace-with-a-strong-password
